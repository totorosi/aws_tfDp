{
  // ##################################################################################
  // Terraform 확장 설정
  // ----------------------------------------------------------------------------------
  // [왜 필요한가]
  // 확장은 디렉터리에 .terraform 이 없으면 레지스트리의 "최신" 프로바이더 스키마로
  // 검사합니다. helm 은 3.0 에서 문법이 바뀌었기 때문에(set{} -> set=[],
  // kubernetes{} -> kubernetes={}), 2.x 로 짠 코드가 빨갛게 표시됩니다.
  //
  // 실제 해결은 각 모듈에서 terraform init 을 한 번 돌려 스키마를 받는 것입니다.
  //   cd project-module/modules/<모듈> && terraform init -backend=false
  // 이 저장소는 모든 모듈에 이미 돌려 두었습니다.
  //
  // 빨간 줄이 보이면 판단 기준은 항상 이것입니다.
  //   cd project-module/projects && terraform validate
  //   Success 면 에디터 오탐, Error 면 진짜 문제.
  // ##################################################################################

  // 인덱싱에서 제외할 디렉터리 (맥 압축 부산물과 프로바이더 캐시)
  "terraform.languageServer.indexing.ignoreDirectoryNames": [
    ".terraform",
    "__MACOSX"
  ],

  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // 확장자가 달라 인식 못 하는 파일들을 올바른 문법으로 잡아 줍니다.
  "files.associations": {
    "*.tfvars.example": "terraform-vars",
    "backend.hcl": "terraform-vars",
    "backend.hcl.example": "terraform-vars"
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
